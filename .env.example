# --- environment ---------------------------------------------------------
# development (default) | production
# production turns OFF auto table creation and the /docs endpoints.
ENVIRONMENT=development

# --- database ------------------------------------------------------------
DATABASE_URL=sqlite:///./finance.db
# DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/qa_finance

# Create tables on startup. Unsafe with more than one worker - run
# `python -m scripts.init_db` as a release step instead.
# Defaults: true in development, false in production.
# AUTO_CREATE_TABLES=false

# --- http ----------------------------------------------------------------
# Expose /docs, /redoc, /openapi.json. Defaults to true outside production.
# ENABLE_DOCS=false

# Comma-separated browser origins. Empty (default) disables CORS entirely,
# which is correct for a server-to-server API.
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# --- auth ----------------------------------------------------------------
TOKEN_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- paging --------------------------------------------------------------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# --- llm -----------------------------------------------------------------
# "stub" = deterministic offline provider (default, used by the test suite)
# "anthropic" = live Claude calls, requires ANTHROPIC_API_KEY
LLM_PROVIDER=stub
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
